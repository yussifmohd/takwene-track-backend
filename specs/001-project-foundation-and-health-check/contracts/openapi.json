{
  "openapi": "3.1.1",
  "info": {
    "title": "Takwene Track Management API",
    "description": "Manage artists, tracks and their distribution to DSPs. Write operations require an Admin JWT.",
    "version": "v1"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Get API and database health",
        "operationId": "GetHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReportDto"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReportDto"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthCheckEntryDto": {
        "required": [
          "name",
          "status",
          "durationMs"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/HealthState"
          },
          "durationMs": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "HealthReportDto": {
        "required": [
          "status",
          "checkedAt",
          "checks"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthState"
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          },
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HealthCheckEntryDto"
            }
          }
        }
      },
      "HealthState": {
        "enum": [
          "healthy",
          "degraded",
          "unhealthy"
        ]
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "JWT access token from POST /api/auth/login.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "Health"
    }
  ]
}
