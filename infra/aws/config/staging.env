# Track Management – staging environment. Non-secret settings only: secrets are generated into
# SSM Parameter Store by setup.sh and never stored in files. Personal changes go in
# config/staging.local.env (git-ignored), which is read after this file.

ENVIRONMENT=staging
PROJECT=trackmgmt
AWS_REGION=eu-central-1
# Empty = the first availability zones the region offers.
AVAILABILITY_ZONES=""

# --- network ---
VPC_CIDR=10.20.0.0/16
# Load balancer and instances (instances get public IPs but accept traffic only from the load balancer).
PUBLIC_SUBNET_CIDRS="10.20.0.0/24 10.20.1.0/24"
# Database only; no route to the internet.
PRIVATE_SUBNET_CIDRS="10.20.10.0/24 10.20.11.0/24"

# --- load balancer ---
# Who may reach the load balancer. Narrow it (e.g. an office range) for a private test.
ALB_INGRESS_CIDR=0.0.0.0/0
# Optional HTTPS: an ISSUED ACM certificate in the same region. Empty = HTTP only (no domain yet).
CERTIFICATE_ARN=""
ALB_SSL_POLICY=ELBSecurityPolicy-TLS13-1-2-2021-06
ALB_DELETION_PROTECTION=false

# --- instances (Auto Scaling group) ---
# Same instance size as prod so problems show up before release.
INSTANCE_TYPE=t3.small
EBS_VOLUME_GB=20
ASG_MIN=2
ASG_DESIRED=2
ASG_MAX=3
SCALE_CPU_TARGET=60

# --- database (RDS PostgreSQL) ---
# Single-AZ to keep cost down; backups kept for three days.
DB_INSTANCE_CLASS=db.t4g.micro
DB_ENGINE_VERSION=17
DB_ALLOCATED_STORAGE=20
DB_MULTI_AZ=false
DB_BACKUP_RETENTION_DAYS=3
DB_DELETION_PROTECTION=false
DB_NAME=trackmgmt
DB_USERNAME=trackmgmt_admin
# VerifyFull checks the RDS certificate against Amazon's CA bundle (downloaded on each instance).
DB_SSL_MODE=VerifyFull

# --- application ---
# The one admin account, created on the first deploy. Its password is generated into SSM.
ADMIN_EMAIL=admin@takwene.local
ECR_KEEP_IMAGES=10
LOG_RETENTION_DAYS=14
# Private S3 bucket (encrypted, versioned, no public access). The app does not use it yet.
S3_BUCKET_ENABLED=false
# Frontend repository folder; empty = a sibling clone named "frontend" or "takwene-track-frontend".
FRONTEND_DIR=""
