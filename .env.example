# Copy to .env and fill in. Never commit .env.
# Used by docker-compose.yml.

# --- Database (container) ---
POSTGRES_DB=trackmgmt
POSTGRES_USER=trackmgmt
POSTGRES_PASSWORD=change-me-local-only

# Host port for the database (bound to 127.0.0.1). Change it if 5432 is already in use.
POSTGRES_HOST_PORT=5432

# --- API ---
ASPNETCORE_ENVIRONMENT=Development
# HS256 signing key: at least 32 characters. Generate one, e.g.
#   PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
#   bash:       openssl rand -base64 48
JWT__SIGNINGKEY=
JWT__ISSUER=trackmgmt-api
JWT__AUDIENCE=trackmgmt-web
JWT__EXPIRATIONMINUTES=60

# --- Admin account (created on first start if missing; an existing account is never changed) ---
# Password rules: at least 12 characters with upper case, lower case, a digit and a symbol.
ADMIN__EMAIL=admin@takwene.local
ADMIN__PASSWORD=

# --- Sign-in protection ---
# Proxies allowed to set X-Forwarded-For (CIDR). Docker's private range by default;
# on AWS use the VPC CIDR of the load balancer (Phase 6).
REVERSE_PROXY_KNOWN_NETWORK=172.16.0.0/12
# Sign-in attempts allowed per client IP per window.
RATE_LIMIT_LOGIN_PERMIT_LIMIT=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
